# GREENATICS CONTROL 0.22.0-initial-rc2 commissioning template
#
# DO NOT populate this file in the repository.
# Supply real values from the deployment environment / secret store.
# This template contains no production credential, token, private key or approval.

# Exact release-candidate binding
AGROWAY_CONTROL_RUNTIME_MODE=PRODUCTION
AGROWAY_CONTROL_BOOTSTRAP_MODE=PRODUCTION_EXTERNAL_BINDINGS
AGROWAY_CONTROL_RELEASE_VERSION=0.22.0-initial-rc2
AGROWAY_CONTROL_GIT_HEAD_SHA=<EXACT_40_HEX_CERTIFIED_RC2_HEAD>
AGROWAY_CONTROL_REVIEW_BUNDLE_SHA256=<EXACT_64_HEX_CERTIFIED_RC2_ARTIFACT_DIGEST>

# OIDC / JWKS — read-only provider preflight
AGROWAY_OIDC_ISSUER=<HTTPS_ISSUER>
AGROWAY_OIDC_JWKS_URI=<HTTPS_JWKS_URI>
AGROWAY_OIDC_AUDIENCE=<PRODUCTION_AUDIENCE>
AGROWAY_OIDC_TENANT_CLAIM=<TENANT_CLAIM_NAME>
AGROWAY_OIDC_SESSION_CLAIM=<SESSION_CLAIM_NAME>
AGROWAY_OIDC_ALLOWED_ALGORITHMS=RS256,ES256
AGROWAY_OIDC_AAL2_ACR_VALUES=<COMMA_SEPARATED_AAL2_ACR_VALUES>
AGROWAY_OIDC_AAL3_ACR_VALUES=<OPTIONAL_COMMA_SEPARATED_AAL3_ACR_VALUES>
AGROWAY_OIDC_MFA_AMR_VALUES=<COMMA_SEPARATED_MFA_AMR_VALUES>
# Optional bounded tuning:
# AGROWAY_OIDC_CLOCK_SKEW_SECONDS=30
# AGROWAY_OIDC_MAX_TOKEN_AGE_SECONDS=900
# AGROWAY_OIDC_JWKS_TIMEOUT_MS=5000
# AGROWAY_OIDC_JWKS_CACHE_TTL_MS=300000
# AGROWAY_OIDC_JWKS_MAX_BYTES=65536
# AGROWAY_OIDC_JWKS_MAX_KEYS=32

# PostgreSQL — TLS + read-only identity probe
AGROWAY_POSTGRES_HOST=<PRODUCTION_DATABASE_HOST>
AGROWAY_POSTGRES_PORT=5432
AGROWAY_POSTGRES_DATABASE=<DATABASE_NAME>
AGROWAY_POSTGRES_USER=<DATABASE_USER>
AGROWAY_POSTGRES_PASSWORD=<EXTERNAL_SECRET_MIN_20_CHARS>
AGROWAY_POSTGRES_CA_PEM=<PEM_CERTIFICATE_INJECTED_BY_SECRET_STORE>
AGROWAY_POSTGRES_TLS_SERVERNAME=<SAME_VALUE_AS_DATABASE_HOST>
# Optional bounded tuning:
# AGROWAY_POSTGRES_POOL_MAX=10
# AGROWAY_POSTGRES_CONNECT_TIMEOUT_MS=5000
# AGROWAY_POSTGRES_STATEMENT_TIMEOUT_MS=10000

# External ACK provider — metadata preflight only
AGROWAY_EXTERNAL_ACK_PROVIDER_ID=<PROVIDER_ID>
AGROWAY_EXTERNAL_ACK_ENDPOINT=<HTTPS_ACK_ENDPOINT_WITHOUT_QUERY>
AGROWAY_EXTERNAL_ACK_METADATA_URI=<HTTPS_METADATA_URI_SAME_ORIGIN_AS_ENDPOINT>
AGROWAY_EXTERNAL_ACK_AUTH_MODE=<NONE_OR_BEARER>
# Required only when AUTH_MODE=BEARER; inject externally, never commit:
AGROWAY_EXTERNAL_ACK_BEARER_TOKEN=<EXTERNAL_SECRET_WHEN_BEARER>
AGROWAY_EXTERNAL_ACK_VERIFICATION_KEYS_JSON=<JSON_ARRAY_OF_ED25519_PUBLIC_KEYS>
# Optional bounded tuning:
# AGROWAY_EXTERNAL_ACK_TIMEOUT_MS=5000
# AGROWAY_EXTERNAL_ACK_MAX_RESPONSE_BYTES=65536
# AGROWAY_EXTERNAL_ACK_MAX_ACK_AGE_MS=300000
# AGROWAY_EXTERNAL_ACK_CLOCK_SKEW_MS=30000
# AGROWAY_EXTERNAL_ACK_METADATA_TIMEOUT_MS=5000
# AGROWAY_EXTERNAL_ACK_METADATA_MAX_BYTES=16384
